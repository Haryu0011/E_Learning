@model List<E_Learning.ViewModels.StudentHistoryViewModel>

@{
    ViewData["Title"] = "Riwayat Tugas";
}

<h1>Riwayat Tugas</h1>

<p>
    Berikut adalah daftar tugas yang sudah Anda kumpulkan.
</p>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        Belum ada tugas yang dikumpulkan.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tugas</th>
                <th>Mata Pelajaran</th>
                <th>Dikumpulkan</th>
                <th>Nilai</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>

                    <td>@item.Subject</td>

                    <td>
                        @item.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @if (item.IsGraded)
                        {
                            <strong>@item.Score</strong>
                        }
                        else
                        {
                            <span class="text-muted">
                                Belum dinilai
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Student"
                           asp-action="Detail"
                           asp-route-id="@item.TaskId"
                           class="btn btn-secondary btn-sm">
                            Lihat
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Student"
   asp-action="Index"
   class="btn btn-primary">
    Kembali ke Dashboard
</a>