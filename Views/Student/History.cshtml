@model E_Learning.ViewModels.StudentHistoryPageViewModel

@{
    ViewData["Title"] = "Riwayat Tugas";
    Layout = "_StudentLayout";
}

<div class="student-page">

    <div class="student-shell">

        @await Html.PartialAsync("_StudentSidebar", "Riwayat")

        <!-- MAIN PANEL -->
        <main class="student-main">

            <div class="student-page-title">
                <div class="student-brand">
                    <h1><b>Riwayat Pengumpulan Tugas</b></h1>
                </div>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="student-details-empty">
                    <p>Belum ada tugas yang dikumpulkan.</p>
                </div>
            }
            else
            {
                <table class="student-task-table">

                    <thead>
                        <tr>
                            <th>Tugas</th>
                            <th>Mata Pelajaran</th>
                            <th>Tenggat Waktu</th>
                            <th>Nilai</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            var isSelected = ViewBag.SelectedId == item.TaskId;

                            <tr class="task-row @(isSelected ? "selected" : "")"
                                data-url="@Url.Action(
                                                                                "History",
                                                                                "Student",
                                                                                new { selectedId = item.TaskId })">

                                <td>
                                    @item.Title
                                </td>

                                <td>
                                    @item.Subject
                                </td>

                                <td>
                                    @item.SubmittedAt.ToString("dd/MM/yyyy, HH:mm")
                                </td>

                                <td>
                                    @if (item.IsGraded)
                                    {
                                        <strong>@item.Score</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Belum dinilai</span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </main>

        @{
            ViewData["ShowScore"] = false;
        }
        @await Html.PartialAsync("_TaskDetailPanel", Model.SelectedTask)

    </div>

</div>