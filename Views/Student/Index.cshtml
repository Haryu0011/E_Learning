@model E_Learning.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "Tugas";
}

<div class="student-page">

            <!-- Pop-Ups -->
    @if (TempData["Success"] != null)
{
    <div class="submission-popup-overlay" id="submissionSuccessPopup">

        <div class="submission-popup">

            <div class="submission-popup-icon">
                ✓
            </div>

            <div class="submission-popup-title">
                Sip, tugasmu berhasil disimpan
            </div>

            <div class="submission-popup-divider"></div>

            <div class="submission-popup-content">

                <div class="submission-popup-section-title">
                    Lampiran Tugas
                </div>

                @if (Model.SelectedTask?.SubmissionAttachments != null &&
                     Model.SelectedTask.SubmissionAttachments.Any())
                {
                    @foreach (var attachment in Model.SelectedTask.SubmissionAttachments)
                    {
                        <div class="submission-popup-file">
                            @attachment.FileName
                        </div>
                    }
                }
                else
                {
                    <div class="submission-popup-file">
                        File berhasil dikumpulkan.
                    </div>
                }

            </div>

            <button type="button"
                    class="submission-popup-button"
                    id="closeSubmissionPopup">
                OK
            </button>

        </div>

    </div>
}

    @if (TempData["Error"] != null)
{
    <div class="student-error-message"
         id="studentErrorMessage">

        <strong>Perhatian</strong>

        <div>
            @TempData["Error"]
        </div>

        <button type="button"
                id="closeStudentError">
            Tutup
        </button>

    </div>
}

    <div class="student-shell">

        <!-- LEFT SIDE PANEL -->
        <aside class="student-sidebar">

            <nav class="student-nav">

                <a asp-controller="Student"
                   asp-action="Index"
                   class="student-nav-link active">
                    Dashboard
                </a>

                <a asp-controller="Student"
                   asp-action="History"
                   class="student-nav-link">
                    Riwayat
                </a>

            </nav>

            <div class="student-logout">

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="/Identity/Account/Login"
                      method="post">

                    <button type="submit">
                        Keluar
                    </button>

                </form>

            </div>

        </aside>

        <!-- MAIN PANEL -->
        <main class="student-main">

            <div class="student-page-title">
                <div class="student-brand">
                    <h1><b>E-Learning Sekolah ABC</b></h1>
                </div>
            </div>

            <div class="student-filters">

                <a asp-controller="Student"
                   asp-action="Index"
                   asp-route-status="Semua"
                   class="student-filter @(ViewBag.CurrentStatus == "Semua" ? "active" : "")">
                    Semua
                </a>

                <a asp-controller="Student"
                   asp-action="Index"
                   asp-route-status="Telat"
                   class="student-filter @(ViewBag.CurrentStatus == "Telat" ? "active" : "")">
                    Telat
                </a>

                <a asp-controller="Student"
                   asp-action="Index"
                   asp-route-status="Kosong"
                   class="student-filter @(ViewBag.CurrentStatus == "Kosong" ? "active" : "")">
                    Kosong
                </a>

                <a asp-controller="Student"
                   asp-action="Index"
                   asp-route-status="Terkirim"
                   class="student-filter @(ViewBag.CurrentStatus == "Terkirim" ? "active" : "")">
                    Terkirim
                </a>

            </div>

            @if (!Model.Tasks.Any())
            {
                <div class="student-details-empty">
                    <p>Tidak ada tugas.</p>
                </div>
            }
            else
            {
                <table class="student-task-table">

                    <thead>
                        <tr>
                            <th>Tugas</th>
                            <th>Mata Pelajaran</th>
                            <th>Tenggat Waktu</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var task in Model.Tasks)
                        {
                            var isSelected = ViewBag.SelectedId == task.Id;

                            <tr class="task-row @(isSelected ? "selected" : "")"
                                data-url="@Url.Action(
                                                "Index",
                                                "Student",
                                                new
                                                {
                                                    selectedId = task.Id,
                                                    status = ViewBag.CurrentStatus
                                                })">

                                <td>
                                    @task.Title
                                </td>

                                <td>
                                    @task.Subject
                                </td>

                                <td>
                                    @task.DueDate.ToString("dd/MM/yyyy, HH:mm")
                                </td>

                                <td>
                                    @if (task.Status == "Telat")
                                    {
                                        <span class="student-status student-status-telat">
                                            Telat
                                        </span>
                                    }
                                    else if (task.Status == "Kosong")
                                    {
                                        <span class="student-status student-status-kosong">
                                            Kosong
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="student-status student-status-terkirim">
                                            Terkirim
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </main>

        <!-- RIGHT DETAILS PANEL -->
        <aside class="student-details">

        @if (Model.SelectedTask == null)
        {
            <div class="student-details-empty">
                <div>
                    <p>Pilih tugas untuk melihat detail.</p>
                </div>
            </div>
        }
        else
        {
            <div class="student-details-header">

                <div class="student-task-icon">
                    ◉
                </div>

                <div>
                    <div class="student-details-title">
                        @Model.SelectedTask.Title
                    </div>

                    <div class="student-details-subject">
                        @Model.SelectedTask.Subject
                    </div>
                </div>

            </div>

            <!-- DEADLINE -->

            <div class="student-card">

                <div class="student-card-title">
                    ◉ Tenggat Waktu
                </div>

                <div class="student-card-body">
                    @Model.SelectedTask.DueDate.ToString("dd/MM/yyyy, HH:mm")
                </div>

            </div>

            <!-- DESCRIPTION -->

            <div class="student-card">

                <div class="student-card-title">
                    ◉ Deskripsi
                </div>

                <div class="student-card-body">
                    @Model.SelectedTask.Description
                </div>

            </div>

            <!-- MATERIAL -->

            @if (Model.SelectedTask.Attachments.Any())
            {
                <div class="student-card">

                    <div class="student-card-title">
                        ◉ Instruksi & Materi
                    </div>

                    @foreach (var attachment in Model.SelectedTask.Attachments)
                    {
                        <div class="student-file-item">

                            <div class="student-file-name">
                                ◉
                                @attachment.FileName
                            </div>

                            <a href="@attachment.FilePath"
                               target="_blank"
                               class="student-file-button text-decoration-none">
                                Lihat
                            </a>

                        </div>
                    }

                </div>
            }

            <!-- STATUS -->

            <div class="student-card">

                <div class="student-card-title">
                    ◉ Status
                </div>

                @if (Model.SelectedTask.IsSubmitted)
                {
                    <span class="student-status student-status-terkirim">
                        Terkirim
                    </span>
                }
                else if (DateTime.Now > Model.SelectedTask.DueDate)
                {
                    <span class="student-status student-status-telat">
                        Telat
                    </span>
                }
                else
                {
                    <span class="student-status student-status-kosong">
                        Kosong
                    </span>
                }

            </div>

            @if (Model.SelectedTask.IsSubmitted)
            {
                <!-- SUBMISSION RESULT -->

                <div class="student-card">

                    <div class="student-card-title">
                        ◉ Jawaban Terkirim
                    </div>

                    <div class="student-card-body mb-3">
                        Dikumpulkan pada
                        <strong>
                            @Model.SelectedTask.SubmittedAt?.ToString("dd/MM/yyyy, HH:mm")
                        </strong>
                    </div>

                    @foreach (var attachment in Model.SelectedTask.SubmissionAttachments)
                    {
                        <div class="student-file-item">

                            <div class="student-file-name">
                                ◉
                                @attachment.FileName
                            </div>

                            <a href="@attachment.FilePath"
                               target="_blank"
                               class="student-file-button text-decoration-none">
                                Lihat
                            </a>

                        </div>
                    }

                    @if (Model.SelectedTask.Score.HasValue)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            ◉ Nilai :
                            <strong>@Model.SelectedTask.Score</strong>
                        </div>
                    }

                </div>
            }
            else
            {
                <!-- SUBMIT -->

                <div class="student-card">

                    <div class="student-card-title">
                        ◉ Lampiran Jawaban
                    </div>

                    @if (DateTime.Now > Model.SelectedTask.DueDate)
                    {
                        <div class="student-late-warning">
                            <strong>TERLAMBAT</strong><br />
                            Pengumpulan tetap diperbolehkan.
                        </div>
                    }

                    <form asp-controller="Student"
                          asp-action="Submit"
                          asp-route-id="@Model.SelectedTask.Id"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="student-upload-area">

                            <div>◉</div>

                            <p class="mt-2 mb-2">
                                Pilih file jawaban untuk dikumpulkan.
                            </p>

                            <input type="file"
                                   name="SubmissionFiles"
                                   multiple
                                   class="form-control" />

                            <small class="text-muted">
                                PDF, DOCX, ZIP, JPG, PNG
                            </small>

                        </div>

                        <button type="submit"
                                class="student-submit-button">
                            Kirim
                        </button>

                    </form>

                </div>
            }
        }

        </aside>

    </div>

</div>

<!-- Clicking Behaviour -->
<script>
    document.querySelectorAll(".task-row").forEach(row => {
        row.addEventListener("click", function () {
            const url = this.dataset.url;

            if (url) {
                window.location.href = url;
            }
        });
    });
</script>

<!-- Submission Success Popup Behaviour -->
<script>
    const submissionPopup =
        document.getElementById("submissionSuccessPopup");

    const closeSubmissionPopup =
        document.getElementById("closeSubmissionPopup");

    if (submissionPopup && closeSubmissionPopup) {
        closeSubmissionPopup.addEventListener("click", function () {
            submissionPopup.remove();
        });
    }
</script>

<!-- Error Message Behaviour -->
<script>
    const errorMessage =
        document.getElementById("studentErrorMessage");

    const closeError =
        document.getElementById("closeStudentError");

    if (errorMessage && closeError) {
        closeError.addEventListener("click", function () {
            errorMessage.remove();
        });
    }
</script>