@model string

<div class="teacher-sidebar">

    <nav class="teacher-sidebar-nav">

        <a asp-controller="Teacher"
           asp-action="Index"
           class="teacher-nav-link @(Model == "Dashboard" ? "active" : "")">

            <i class="bi bi-house-door teacher-nav-icon"></i>

            <span>Dashboard</span>

        </a>

        <a asp-controller="Teacher"
           asp-action="History"
           class="teacher-nav-link @(Model == "History" ? "active" : "")">

            <i class="bi bi-clock-history teacher-nav-icon"></i>

            <span>Riwayat</span>

        </a>

        <a asp-controller="Teacher"
           asp-action="Create"
           class="teacher-nav-link @(Model == "Create" ? "active" : "")">

            <i class="bi bi-plus-lg teacher-nav-icon"></i>

            <span>Buat Tugas Baru</span>

        </a>

    </nav>

    <div class="teacher-logout">

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="/Identity/Account/Login"
              method="post">

            <button type="submit">
                <i class="bi bi-box-arrow-right"></i>
                Keluar
            </button>

        </form>

    </div>

</div>