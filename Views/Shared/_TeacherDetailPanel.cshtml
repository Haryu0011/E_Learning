@model E_Learning.ViewModels.TeacherDashboardViewModel

<aside class="teacher-details">

    @if (Model.SelectedTask == null)
    {
        <div class="teacher-details-empty">

            <p>
                Pilih tugas untuk melihat detail.
            </p>

        </div>
    }
    else
    {
        <!-- =================================================
             TASK INFORMATION
             ================================================= -->

        <div class="teacher-details-header">

            <div class="teacher-details-icon">
                ◉
            </div>

            <div>

                <div class="teacher-details-title">
                    @Model.SelectedTask.Title
                </div>

                <div class="teacher-details-subject">
                    @Model.SelectedTask.Subject
                </div>

            </div>

        </div>


        <!-- =================================================
             SUBJECT / DEADLINE
             ================================================= -->

        <div class="teacher-details-meta">

            <div class="teacher-meta-item">

                <span class="teacher-meta-icon">
                    ◉
                </span>

                <div>

                    <span class="teacher-meta-label">
                        Mata Pelajaran
                    </span>

                    <strong>
                        @Model.SelectedTask.Subject
                    </strong>

                </div>

            </div>


            <div class="teacher-meta-item">

                <span class="teacher-meta-icon">
                    ◉
                </span>

                <div>

                    <span class="teacher-meta-label">
                        Tenggat Waktu
                    </span>

                    <strong>
                        @Model.SelectedTask.DueDate.ToString(
                            "dd/MM/yyyy, HH:mm")
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             DESCRIPTION
             ================================================= -->

        <div class="teacher-details-section">

            <div class="teacher-details-section-title">
                ◉ Deskripsi
            </div>

            <div class="teacher-details-description">
                @Model.SelectedTask.Description
            </div>

        </div>


        <!-- =================================================
             MATERIAL / ATTACHMENTS
             ================================================= -->
        @if (Model.SelectedTask.Attachments.Any())
        {
            <div class="teacher-details-section">

                <div class="teacher-details-section-title">
                    ◉ Instruksi dan Materi
                </div>

                <div class="teacher-file-list">

                    @foreach (var attachment
                        in Model.SelectedTask.Attachments)
                    {
                        <div class="teacher-file-item">

                            <div class="teacher-file-name"
                                 title="@attachment.FileName">

                                <span class="teacher-file-icon">
                                    ◉
                                </span>

                                <span>
                                    @attachment.FileName
                                </span>

                            </div>

                            <a href="@attachment.FilePath"
                               target="_blank"
                               class="teacher-file-action"
                               title="Buka file">

                                ◉

                            </a>

                        </div>
                    }

                </div>

            </div>
        }


        <!-- =================================================
             SELECTED SUBMISSION
             ================================================= -->
        @if (Model.SelectedSubmission == null)
        {
            <div class="teacher-details-select-hint">

                <span class="teacher-details-select-icon">
                    ◉
                </span>

                <p>
                    Pilih pengumpulan siswa pada tabel
                    untuk melihat detail dan memberikan nilai.
                </p>

            </div>
        }
        else
        {
            <div class="teacher-details-section">

                <div class="teacher-details-section-title">
                    ◉ Pengumpulan Siswa
                </div>

                <div class="teacher-submission-info">

                    <div class="teacher-submission-student">
                        @Model.SelectedSubmission.StudentEmail
                    </div>

                    <div>
                        Dikumpulkan:
                        <strong>
                            @Model.SelectedSubmission
                            .SubmittedAt
                            .ToString("dd/MM/yyyy, HH:mm")
                        </strong>
                    </div>

                </div>


                @if (Model.SelectedSubmission.IsLate)
                {
                    <div class="teacher-late-box">

                        <strong>
                            TERLAMBAT
                        </strong>

                        <span>
                            Pengumpulan dilakukan setelah
                            batas waktu.
                        </span>

                    </div>
                }
                else
                {
                    <div class="teacher-ontime-box">

                        <strong>
                            TEPAT WAKTU
                        </strong>

                        <span>
                            Pengumpulan dilakukan sebelum
                            batas waktu.
                        </span>

                    </div>
                }


                @if (Model.SelectedSubmission.IsGraded)
                {
                    <div class="teacher-grade-box">

                        <div>
                            Nilai
                        </div>

                        <strong>
                            @Model.SelectedSubmission.Score
                        </strong>

                    </div>

                    <div class="teacher-grade-locked">
                        Nilai sudah diberikan dan tidak dapat diubah.
                    </div>
                }
                else
                {
                    <form asp-controller="Teacher"
                          asp-action="Grade"
                          asp-route-id="@Model.SelectedSubmission.SubmissionId"
                          method="post">

                        <div class="teacher-grade-input-label">
                            Nilai
                        </div>

                        <input name="Score"
                               type="number"
                               min="0"
                               max="100"
                               class="teacher-grade-input"
                               placeholder="Masukkan nilai" />

                        <button type="submit"
                                class="teacher-grade-button">

                            Beri Nilai

                        </button>

                    </form>
                }

            </div>
        }

    }

</aside>