@model E_Learning.ViewModels.CreateTaskViewModel

@{
    ViewData["Title"] = "Buat Tugas Baru";
    Layout = "_TeacherLayout";
}

<div class="teacher-page">

    <div class="teacher-shell">

        @await Html.PartialAsync(
            "_TeacherSidebar",
            "Create")

        <!-- =====================================================
             MAIN PANEL
             ===================================================== -->

        <main class="teacher-main teacher-create-main">

            <div class="teacher-main-header">

                <h1>Buat Tugas</h1>

                <hr />
            </div>

            <div class="teacher-create-card">

                <form asp-controller="Teacher"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="teacher-create-validation"></div>


                    <!-- JUDUL -->

                    <div class="teacher-form-group">

                        <label asp-for="Title"
                               class="teacher-form-label">
                            Judul
                        </label>

                        <input asp-for="Title"
                               class="teacher-form-input"
                               placeholder="Masukan judul tugas" />

                        <span asp-validation-for="Title"
                              class="teacher-form-error">
                        </span>

                    </div>


                    <!-- MATA PELAJARAN -->

                    <div class="teacher-form-group">

                        <label asp-for="Subject"
                               class="teacher-form-label">
                            Mata Pelajaran
                        </label>

                        <input asp-for="Subject"
                               class="teacher-form-input"
                               placeholder="Masukan Mata Pelajaran yang diajar" />

                        <span asp-validation-for="Subject"
                              class="teacher-form-error">
                        </span>

                    </div>


                    <!-- DESKRIPSI -->

                    <div class="teacher-form-group">

                        <label asp-for="Description"
                               class="teacher-form-label">
                            Deskripsi
                        </label>

                        <textarea asp-for="Description"
                                  class="teacher-form-textarea"
                                  rows="3"
                                  placeholder="Masukan deskripsi tugas"></textarea>

                        <span asp-validation-for="Description"
                              class="teacher-form-error">
                        </span>

                    </div>


                    <!-- DEADLINE -->

                    <div class="teacher-form-group">

                        <label asp-for="DueDate"
                               class="teacher-form-label">
                            Tenggat Waktu
                        </label>

                        <div class="teacher-form-input-icon">

                            <input asp-for="DueDate"
                                   type="datetime-local"
                                   class="teacher-form-input teacher-form-input-with-icon" />

                        </div>

                        <span asp-validation-for="DueDate"
                              class="teacher-form-error">
                        </span>

                    </div>


                    <!-- ATTACHMENTS -->

                    <div class="teacher-form-group">

                        <label asp-for="Attachments"
                               class="teacher-form-label">
                            Lampiran
                        </label>

                        <label class="teacher-file-picker">

                            <input asp-for="Attachments"
                                   type="file"
                                   multiple
                                   class="teacher-file-input" />

                            <span class="teacher-file-button">
                                Tambah +
                            </span>

                            <span class="teacher-file-name"
                                  id="attachmentNames">
                                Belum ada file
                            </span>

                        </label>

                        <span asp-validation-for="Attachments"
                              class="teacher-form-error">
                        </span>

                    </div>


                    <!-- ACTIONS -->

                    <div class="teacher-form-actions">

                        <a asp-controller="Teacher"
                           asp-action="Index"
                           class="teacher-cancel-button">
                            Batal
                        </a>

                        <button type="submit"
                                class="teacher-create-button">
                            Simpan Tugas
                        </button>

                    </div>

                </form>

            </div>

        </main>


        <!-- =====================================================
             RIGHT PANEL
             ===================================================== -->

        <aside class="teacher-details teacher-create-details">

            <div class="teacher-details-header">

                <div>

                    <div class="teacher-details-title">
                        Tugas Baru
                    </div>

                    <div class="teacher-details-subject">
                        Informasi terkait pembuatan tugas
                    </div>

                    <hr />

                </div>

            </div>

            <div class="teacher-create-info">

                <div class="teacher-create-info-item">

                    <div class="teacher-create-info-icon">
                        ◉
                    </div>

                    <div>

                        <strong>
                            Judul & Mata Pelajaran
                        </strong>

                        <p>
                            Berikan identitas tugas yang
                            mudah dikenali siswa.
                        </p>

                    </div>

                </div>


                <div class="teacher-create-info-item">

                    <div class="teacher-create-info-icon">
                        ◉
                    </div>

                    <div>

                        <strong>
                            Deskripsi
                        </strong>

                        <p>
                            Jelaskan tugas dan ketentuan
                            yang perlu dikerjakan siswa.
                        </p>

                    </div>

                </div>


                <div class="teacher-create-info-item">

                    <div class="teacher-create-info-icon">
                        ◉
                    </div>

                    <div>

                        <strong>
                            Batas Pengumpulan
                        </strong>

                        <p>
                            Tentukan tanggal dan waktu
                            terakhir pengumpulan.
                        </p>

                    </div>

                </div>


                <div class="teacher-create-info-item">

                    <div class="teacher-create-info-icon">
                        ◉
                    </div>

                    <div>

                        <strong>
                            Lampiran
                        </strong>

                        <p>
                            Tambahkan materi atau dokumen
                            yang diperlukan siswa.
                        </p>

                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>


<!-- =========================================================
     SNACKBAR
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="teacher-snackbar teacher-snackbar-success"
         id="teacherSnackbar">

        @TempData["Success"]

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="teacher-snackbar teacher-snackbar-error"
         id="teacherSnackbar">

        @TempData["Error"]

    </div>
}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const snackbar =
            document.getElementById("teacherSnackbar");

        if (snackbar) {

            setTimeout(() => {

                snackbar.classList.add(
                    "teacher-snackbar-hide");

                setTimeout(() => {
                    snackbar.remove();
                }, 250);

            }, 3000);

        }


        // Show the chosen attachment names next to "Tambah +".
        const attachmentInput =
            document.getElementById("Attachments");

        const attachmentNames =
            document.getElementById("attachmentNames");

        if (attachmentInput && attachmentNames) {

            attachmentInput.addEventListener("change", function () {

                const names = Array.from(this.files)
                    .map(file => file.name);

                attachmentNames.textContent = names.length
                    ? names.join(", ")
                    : "Belum ada file";

                attachmentNames.classList.toggle(
                    "has-file",
                    names.length > 0);

            });

        }

    </script>
}