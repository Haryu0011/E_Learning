@model List<E_Learning.ViewModels.TeacherHistoryViewModel>

@{
    ViewData["Title"] = "Riwayat Tugas";
}

<h1>Riwayat Tugas</h1>

<p>
    Daftar tugas dan seluruh pengumpulan siswa.
</p>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        Belum ada tugas.
    </div>
}
else
{
    <div class="accordion" id="teacherHistoryAccordion">

        @foreach (var task in Model)
        {
            var headingId = $"heading-{task.TaskId}";
            var collapseId = $"collapse-{task.TaskId}";

            <div class="accordion-item mb-2">

                <h2 class="accordion-header"
                    id="@headingId">

                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">

                        <div>
                            <strong>@task.TaskTitle</strong>
                            <div class="small text-muted">
                                @task.Subject
                                ·
                                Deadline:
                                @task.DueDate.ToString("dd/MM/yyyy HH:mm")
                                ·
                                @task.Submissions.Count submission(s)
                            </div>
                        </div>

                    </button>
                </h2>

                <div id="@collapseId"
                     class="accordion-collapse collapse"
                     aria-labelledby="@headingId"
                     data-bs-parent="#teacherHistoryAccordion">

                    <div class="accordion-body">

                        @if (!task.Submissions.Any())
                        {
                            <div class="alert alert-secondary">
                                Belum ada siswa yang mengumpulkan tugas ini.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-bordered table-hover align-middle">

                                    <thead>
                                        <tr>
                                            <th>Siswa</th>
                                            <th>Deadline</th>
                                            <th>Dikumpulkan</th>
                                            <th>Status</th>
                                            <th>Nilai</th>
                                            <th></th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @foreach (var submission in task.Submissions)
                                        {
                                            <tr>

                                                <td>
                                                    @submission.StudentEmail
                                                </td>

                                                <td>
                                                    @task.DueDate.ToString(
                                                        "dd/MM/yyyy HH:mm")
                                                </td>

                                                <td>
                                                    @submission.SubmittedAt.ToString(
                                                        "dd/MM/yyyy HH:mm")
                                                </td>

                                                <td>
                                                    @if (submission.IsLate)
                                                    {
                                                        <span class="badge bg-danger fs-6">
                                                            TERLAMBAT
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            TEPAT WAKTU
                                                        </span>
                                                    }
                                                </td>

                                                <td>
                                                    @if (submission.IsGraded)
                                                    {
                                                        <strong>
                                                            @submission.Score
                                                        </strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            Belum dinilai
                                                        </span>
                                                    }
                                                </td>

                                                <td>
                                                    <a asp-controller="Teacher"
                                                       asp-action="Grade"
                                                       asp-route-id="@submission.SubmissionId"
                                                       class="btn btn-secondary btn-sm">
                                                        Lihat
                                                    </a>
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>
                </div>

            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-controller="Teacher"
       asp-action="Index"
       class="btn btn-primary">
        Kembali ke Dashboard
    </a>
</div>