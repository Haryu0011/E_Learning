@using E_Learning.Helpers
@model E_Learning.ViewModels.TeacherHistoryPageViewModel

@{
    ViewData["Title"] = "Riwayat Penilaian Tugas";
    Layout = "_TeacherLayout";
}

<div class="teacher-page">

    <div class="teacher-shell">

        @await Html.PartialAsync(
            "_TeacherSidebar",
            "History")

        <!-- =====================================================
             MAIN PANEL
             ===================================================== -->

        <main class="teacher-main teacher-history-main">

            <div class="teacher-main-header">

                <h1>Riwayat Penilaian Tugas</h1>
                <p> Berikut adalah rangkuman nilai untuk setiap murid</p>

            </div>

            @if (!Model.Students.Any())
            {
                <div class="teacher-empty-state">
                    <p>
                        Belum ada data siswa.
                    </p>
                </div>
            }
            else
            {
                <div class="teacher-history-list">

                    @foreach (var student in Model.Students)
                    {
                        var contentId =
                            $"history-student-{student.StudentId}";

                        var isSelectedStudent =
                            Model.SelectedSubmission != null &&
                            student.Submissions.Any(
                                s => s.SubmissionId ==
                                     Model.SelectedSubmission.SubmissionId);

                        <section class="teacher-history-card">

                            <!-- STUDENT HEADER -->

                            <div class="teacher-history-header">

                                <div class="teacher-history-student-name">
                                    @student.StudentEmail
                                </div>

                                <button type="button"
                                        class="teacher-history-toggle"
                                        data-target="@contentId"
                                        aria-expanded="true"
                                        aria-controls="@contentId">

                                    <span class="teacher-history-chevron">
                                        ⌃
                                    </span>

                                </button>

                            </div>


                            <!-- STUDENT TABLE -->

                            <div id="@contentId"
                                 class="teacher-history-content">

                                <table class="teacher-history-table">

                                    <thead>
                                        <tr>
                                            <th>Tugas</th>
                                            <th>Status Pengumpulan</th>
                                            <th>Nilai</th>
                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (!student.Submissions.Any())
                                        {
                                            <tr>
                                                <td colspan="3"
                                                    class="teacher-history-empty">

                                                    Belum ada pengumpulan tugas.

                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (
                                                var submission
                                                in student.Submissions)
                                            {
                                                var selected =
                                                    Model.SelectedSubmission
                                                    ?.SubmissionId
                                                    == submission.SubmissionId;

                                                var rowUrl =
                                                    Url.Action(
                                                        "History",
                                                        "Teacher",
                                                        new
                                                        {
                                                            selectedTaskId =
                                                                submission.TaskId,

                                                            selectedSubmissionId =
                                                                submission.SubmissionId
                                                        });

                                                <tr class="teacher-history-row @(selected ? "selected" : "")"
                                                    data-url="@rowUrl">

                                                    <td>
                                                        @submission.TaskTitle
                                                    </td>

                                                    <td>

                                                        @if (submission.IsLate)
                                                        {
                                                            <span class="teacher-status teacher-status-late">
                                                                Telat
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="teacher-status teacher-status-on-time">
                                                                Tepat Waktu
                                                            </span>
                                                        }

                                                    </td>

                                                    <td>

                                                        @if (submission.IsGraded)
                                                        {
                                                            <strong>
                                                                @submission.Score
                                                            </strong>
                                                        }
                                                        else
                                                        {
                                                            <span class="teacher-score-empty">
                                                                -
                                                            </span>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </section>
                    }

                </div>
            }

        </main>


        <!-- =====================================================
             RIGHT DETAILS PANEL
             ===================================================== -->

        <aside class="teacher-details teacher-history-details">

            @if (Model.SelectedTask == null)
            {
                <div class="teacher-details-empty">

                    <p>
                        Pilih pengumpulan siswa untuk melihat detail.
                    </p>

                </div>
            }
            else
            {
                <!-- TASK TITLE -->

                <div class="teacher-details-title-block">

                    <h2 class="teacher-details-title">
                        @Model.SelectedTask.Title
                    </h2>

                </div>


                <!-- TASK META -->

                <div class="teacher-details-meta">

                    <div class="teacher-meta-item">

                        <i class="bi bi-book teacher-meta-icon"></i>

                        <div class="teacher-meta-content">

                            <span class="teacher-meta-label">
                                Mata Pelajaran
                            </span>

                            <strong class="teacher-meta-value">
                                @Model.SelectedTask.Subject
                            </strong>

                        </div>

                    </div>


                    <div class="teacher-meta-item">

                        <i class="bi bi-calendar3 teacher-meta-icon"></i>

                        <div class="teacher-meta-content">

                            <span class="teacher-meta-label">
                                Tenggat Waktu
                            </span>

                            <strong class="teacher-meta-value">
                                @Model.SelectedTask.DueDate.ToString("dd/MM/yyyy, HH:mm")
                            </strong>

                        </div>

                    </div>


                    @if (Model.SelectedSubmission != null)
                    {
                        <div class="teacher-meta-item">

                            <i class="bi bi-clock teacher-meta-icon"></i>

                            <div class="teacher-meta-content">

                                <span class="teacher-meta-label">
                                    Dikumpulkan pada
                                </span>

                                <strong class="teacher-meta-value">
                                    @Model.SelectedSubmission.SubmittedAt.ToString("dd/MM/yyyy, HH:mm")
                                </strong>

                            </div>

                        </div>
                    }

                </div>


                <div class="teacher-details-divider"></div>


                <!-- DESCRIPTION -->

                <section class="teacher-details-section">

                    <h3 class="teacher-details-section-title">
                        Deskripsi
                    </h3>

                    <div class="teacher-details-description">
                        @Model.SelectedTask.Description
                    </div>

                </section>


                <!-- MATERIAL -->
                @if (Model.SelectedTask.Attachments.Any())
                {
                    <section class="teacher-details-section">

                        <h3 class="teacher-details-section-title">
                            Instruksi dan Materi
                        </h3>

                        <div class="teacher-material-list">

                            @foreach (
                                var attachment
                                in Model.SelectedTask.Attachments)
                            {
                                <div class="teacher-material-item">

                                    <i class="bi bi-paperclip teacher-material-icon"></i>

                                    <a href="@attachment.FilePath"
                                       target="_blank"
                                       class="teacher-material-name"
                                       title="@attachment.FileName">

                                        @attachment.FileName

                                    </a>

                                    <a href="@attachment.FilePath"
                                       class="teacher-material-action"
                                       download
                                       title="Download">

                                        <i class="bi bi-download"></i>

                                    </a>

                                </div>
                            }

                        </div>

                    </section>
                }


                <!-- SUBMISSION -->
                @if (Model.SelectedSubmission == null)
                {
                    <div class="teacher-details-select-hint">

                        <i class="bi bi-info-circle"></i>

                        <p>
                            Pilih salah satu tugas siswa
                            pada tabel untuk melihat
                            pengumpulan dan penilaiannya.
                        </p>

                    </div>
                }
                else
                {
                    <section class="teacher-details-section">

                        <!-- SUBMITTED FILES -->
                        @if (Model.SelectedSubmission.Attachments.Any())
                        {

                            <hr />

                            <h3 class="teacher-details-section-title">
                                Lampiran Jawaban
                            </h3>

                            <div class="teacher-material-list">

                                @foreach (
                                    var attachment
                                    in Model.SelectedSubmission.Attachments)
                                {
                                    <div class="teacher-material-item">

                                        <i class="bi @FileIconHelper.GetIcon(attachment.FileName) teacher-material-icon"></i>

                                        <a href="@attachment.FilePath"
                                           target="_blank"
                                           class="teacher-material-name"
                                           title="@attachment.FileName">

                                            @attachment.FileName

                                        </a>

                                        <a href="@attachment.FilePath"
                                           class="teacher-material-action"
                                           download
                                           title="Download">

                                            <i class="bi bi-download"></i>

                                        </a>

                                    </div>
                                }

                            </div>
                        }


                        <!-- GRADE -->
                        @if (!Model.SelectedSubmission.IsGraded)
                        {
                            <form asp-controller="Teacher"
                                  asp-action="Grade"
                                  asp-route-id="@Model.SelectedSubmission.SubmissionId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div class="teacher-grade-input-row">

                                    <strong>
                                        Nilai:
                                    </strong>

                                    <input name="Score"
                                           type="number"
                                           min="0"
                                           max="100"
                                           class="teacher-grade-input"
                                           placeholder="Masukkan nilai"
                                           required />

                                </div>

                                <button type="submit"
                                        class="teacher-grade-button">

                                    Beri Nilai

                                </button>

                            </form>
                        }

                    </section>
                }

            }

        </aside>

    </div>

</div>


<script>

    // =========================================================
    // History row selection
    // =========================================================

    document
        .querySelectorAll(".teacher-history-row")
        .forEach(row => {

            row.addEventListener("click", function() {

                const url = this.dataset.url;

                if (url) {
                    window.location.href = url;
                }

            });

        });


    // =========================================================
    // Independent student accordion
    // =========================================================

    document
        .querySelectorAll(".teacher-history-toggle")
        .forEach(button => {

            button.addEventListener("click", function() {

                const targetId =
                    this.dataset.target;

                const content =
                    document.getElementById(targetId);

                if (!content) {
                    return;
                }

                const isOpen =
                    this.getAttribute("aria-expanded") === "true";

                if (isOpen) {
                    content.classList.add("collapsed");

                    this.setAttribute(
                        "aria-expanded",
                        "false");

                    this.querySelector(
                        ".teacher-history-chevron")
                        .textContent = "⌄";
                }
                else {
                    content.classList.remove("collapsed");

                    this.setAttribute(
                        "aria-expanded",
                        "true");

                    this.querySelector(
                        ".teacher-history-chevron")
                        .textContent = "⌃";
                }

            });

        });

</script>