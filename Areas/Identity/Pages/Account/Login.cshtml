@page
@model E_Learning.Areas.Identity.Pages.Account.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Masuk";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Masuk - E_Learning</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="login-page">

    <div class="login-overlay">

        <div class="login-card">

            <div class="login-header">
                <h1>Masuk</h1>

                <p>
                    Silahkan masukan email dan kata sandi anda
                </p>
            </div>

            <form method="post">

                <div class="login-field">

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control login-input"
                           autocomplete="username"
                           placeholder="Masukan email anda" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="login-field">

                    <label asp-for="Input.Password">
                        Kata Sandi
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="Input.Password"
                               class="form-control login-input"
                               id="passwordInput"
                               autocomplete="current-password"
                               placeholder="Masukan kata sandi anda" />

                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                aria-label="Tampilkan atau sembunyikan password">
                            Tampilkan
                        </button>

                    </div>

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                </div>

                <button type="submit"
                        class="login-button">
                    Masuk
                </button>

            </form>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* jQuery must load before the validation scripts in the partial. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
            const passwordInput =
                document.getElementById("passwordInput");

            const passwordToggle =
                document.getElementById("passwordToggle");

            passwordToggle.addEventListener("click", function() {

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";
                    passwordToggle.textContent = "Sembunyikan";
                    passwordToggle.setAttribute(
                        "aria-label",
                        "Sembunyikan password"
                    );

                } else {

                    passwordInput.type = "password";
                    passwordToggle.textContent = "Tampilkan";
                    passwordToggle.setAttribute(
                        "aria-label",
                        "Tampilkan password"
                    );
                }

            });

            // ---------------------------------------------------------
            // Auto-hide every error message after a timeout.
            // Covers the two field messages and the summary
            // ("Username atau password salah.", "Akun sedang dikunci.").
            // ---------------------------------------------------------
            const ERROR_TIMEOUT_MS = 5000;

            const errorTimers = new WeakMap();

            function scheduleErrorHide(element) {

                clearTimeout(errorTimers.get(element));

                if (!element.textContent.trim()) {
                    return;
                }

                errorTimers.set(element, setTimeout(function() {
                    element.textContent = "";
                }, ERROR_TIMEOUT_MS));
            }

            document
                .querySelectorAll("form .text-danger")
                .forEach(function(element) {

                    // Errors rendered by the server on page load.
                    scheduleErrorHide(element);

                    // Errors added or changed later by client-side
                    // validation: restart the timer each time.
                    new MutationObserver(function() {
                        scheduleErrorHide(element);
                    }).observe(element, {
                        childList: true,
                        subtree: true,
                        characterData: true
                    });
                });
    </script>

</body>
</html>
